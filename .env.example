# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Free AI providers (no paid quotas required) ─────────
# Priority order used by the server (first available wins, then failover):
# 1. Pollinations (no key — always tried first)
# 2. Groq free tier (optional key from console.groq.com)
# 3. OpenRouter free models (optional key from openrouter.ai)
# 4. Ollama local (no key, unlimited if you run ollama)
# 5. Custom OpenAI-compatible endpoint

# Optional — Groq free tier (generous daily limits, no card required)
GROQ_API_KEY=

# Optional — OpenRouter (use :free models)
OPENROUTER_API_KEY=

# Optional — local Ollama (truly unlimited, no network quota)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional — any OpenAI-compatible free endpoint
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Frontend origin for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
