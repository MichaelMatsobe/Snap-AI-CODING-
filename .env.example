# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Free AI providers (failover order) ──────────────────
# 1. Pollinations  — no key required (public text API)
# 2. Ollama local  — unlimited when you run ollama
# 3. Groq free     — optional key from console.groq.com
# 4. OpenRouter    — optional key, use :free models
# 5. Custom        — any OpenAI-compatible endpoint

# Optional — Groq free tier (generous daily limits, no card required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — OpenRouter (prefer models ending in :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Optional — local Ollama (truly unlimited, no network quota)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional — any OpenAI-compatible free endpoint
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Frontend origin for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
